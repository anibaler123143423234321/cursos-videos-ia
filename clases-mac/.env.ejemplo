# Copia este archivo como ".env" (en la misma carpeta) y pega tus claves.
# .env NUNCA se sube a GitHub ni se comparte.

# ---- ElevenLabs (voz clonada) ----
# API key: elevenlabs.io > Developers / API Keys > Create API key (permiso: Text to Speech)
ELEVENLABS_API_KEY=
# Voice ID: My Voices > tu voz clonada > menu (...) > Copy voice ID
ELEVENLABS_VOICE_ID=
# Opcional (valores por defecto):
# ELEVENLABS_MODELO=eleven_multilingual_v2
# ELEVENLABS_ESTABILIDAD=0.5
# ELEVENLABS_SIMILITUD=0.8
# ELEVENLABS_ESTILO=0

# ---- Azure (voces neurales de Peru y Mexico; plan F0: 0,5 millones de caracteres gratis al mes) ----
# portal.azure.com > Crear recurso "Speech" (plan F0) > Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Voz (opcional): es-PE-CamilaNeural (por defecto) | es-PE-AlexNeural | es-MX-DaliaNeural | es-MX-JorgeNeural
# AZURE_VOZ=es-PE-CamilaNeural
# Velocidad (opcional), p. ej. -5% o +5%:
# AZURE_VOZ_VELOCIDAD=0%

# ---- Voz local gratis (sin internet, sin cuenta, sin limite) ----
# Piper: doble clic en INSTALAR-VOZ-LOCAL.command (queda en la carpeta voces). Otra voz (opcional):
# PIPER_VOZ=es_MX-claude-high
# O un servidor de voz en Docker compatible con OpenAI, por ejemplo Kokoro:
#   docker run -p 8880:8880 ghcr.io/remsky/kokoro-fastapi-cpu:latest
# VOZ_LOCAL_URL=http://localhost:8880/v1
# VOZ_LOCAL_VOZ=ef_dora

# ---- Voz preferida ----
# auto = tu grabacion si existe (camara.mp4 / voz/completa.m4a); si no, ElevenLabs, Azure, voz local y voz del sistema
# (la primera que este configurada). Otras: local | azure | elevenlabs | sistema | grabacion
VOZ=auto

# Voz del sistema en Mac (opcional). Ver lista con:  say -v '?' | grep es_
# VOZ_SISTEMA=Paulina

# ---- Web del equipo (INICIAR-WEB) ----
# Clave para entrar a la web (si la dejas vacia, se crea una al encenderla)
WEB_CLAVE=
# Puerto de la web (por defecto 8080)
# WEB_PUERTO=8080

# ---- IA para escribir clases desde la web ----
# Claude (de pago por uso): platform.claude.com > API Keys
ANTHROPIC_API_KEY=
# CLAUDE_MODELO=claude-opus-5-5
# IA gratis compatible con OpenAI: Groq (console.groq.com) u Ollama local (http://localhost:11434/v1)
IA_GRATIS_URL=https://api.groq.com/openai/v1
IA_GRATIS_KEY=
IA_GRATIS_MODELO=openai/gpt-oss-120b
# Tokens por respuesta (por defecto 8000; si el servicio permite menos, la web se ajusta sola)
# IA_GRATIS_MAX_TOKENS=8000

# ---- IA que lee laminas (imagenes o PDF del docente) ----
# Vacio = la misma IA gratis, con un modelo que lee imagenes (en Groq: qwen/qwen3.8-27b).
# Gemini gratis: aistudio.google.com > Get API key (en la capa gratis Google usa los datos para mejorar sus productos)
# IA_VISION_URL=https://generativelanguage.googleapis.com/v1beta/openai
# IA_VISION_KEY=
# IA_VISION_MODELO=gemini-3.8-flash
# Ollama local: IA_VISION_URL=http://localhost:11434/v1  IA_VISION_MODELO=qwen2.5vl:7b

# ---- Google Drive: cada video final y su codigo, en la carpeta compartida del equipo ----
# Quedan en: <carpeta compartida> / <DRIVE_CARPETA> / <AAAA-MM> / <Curso> / <Video con HTML | Video con láminas> / <Modulo> / <clase>
# Enlace (o ID) de la carpeta compartida; tu cuenta debe ser Editor de esa carpeta:
DRIVE_CARPETA_ID=
# Subcarpeta que se crea dentro (por defecto "Videos de clases IA"):
# DRIVE_CARPETA=Videos de clases IA
# A) Con la API de Google: guarda google-drive-cliente.json aqui y abre CONECTAR-DRIVE.command una vez (LEEME).
# B) Sin Google Cloud: Google Drive para escritorio + acceso directo de la carpeta en Mi unidad. Si llenas esto,
#    se copia ahi en vez de usar la API:
# DRIVE_RUTA_LOCAL=/Users/tu-usuario/Library/CloudStorage/GoogleDrive-tu-correo@uss.edu.pe/Mi unidad/CINF GEX
