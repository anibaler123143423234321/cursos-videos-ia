# Copia este archivo como ".env" (en la misma carpeta) y pega tus claves.
# .env NUNCA se sube a GitHub ni se comparte.

# ---- ElevenLabs (voz clonada) ----
# API key: elevenlabs.io > Developers / API Keys > Create API key (permiso: Text to Speech)
ELEVENLABS_API_KEY=
# Voice ID: My Voices > tu voz clonada > menu (...) > Copy voice ID
ELEVENLABS_VOICE_ID=
# Opcional (valores por defecto):
# ELEVENLABS_MODELO=eleven_multilingual_v2
# ELEVENLABS_ESTABILIDAD=0.5
# ELEVENLABS_SIMILITUD=0.8
# ELEVENLABS_ESTILO=0

# ---- Voz preferida ----
# auto = tu grabacion si existe (camara.mp4 / voz/completa.m4a), si no ElevenLabs, si no voz del sistema.
# Otras: elevenlabs | sistema | grabacion
VOZ=auto

# Voz del sistema en Mac (opcional). Ver lista con:  say -v '?' | grep es_
# VOZ_SISTEMA=Paulina

# ---- Web del equipo (INICIAR-WEB) ----
# Clave para entrar a la web (si la dejas vacia, se crea una al encenderla)
WEB_CLAVE=
# Puerto de la web (por defecto 8080)
# WEB_PUERTO=8080

# ---- IA para escribir clases desde la web ----
# Claude (de pago por uso): platform.claude.com > API Keys
ANTHROPIC_API_KEY=
# CLAUDE_MODELO=claude-opus-5-5
# IA gratis compatible con OpenAI: Groq (console.groq.com) u Ollama local (http://localhost:11434/v1)
IA_GRATIS_URL=https://api.groq.com/openai/v1
IA_GRATIS_KEY=
IA_GRATIS_MODELO=openai/gpt-oss-120b
# Tokens por respuesta (por defecto 8000; si el servicio permite menos, la web se ajusta sola)
# IA_GRATIS_MAX_TOKENS=8000
